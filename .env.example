# Env for compose.yaml. Copy to .env (or set these in Dockhand's stack env).

# Required
SCANNER_IP=192.168.0.10
SCANNER_MODEL=MFC-L2700DW
# This host's IP as the scanner sees it - scans are sent here
ADVERTISE_IP=192.168.0.100

# Optional
# Host directory holding brother.yaml, the scan menu (default ./config next
# to compose.yaml). See config/brother.yaml in the repo for an example.
CONFIG_DIR=/data/brother-scan/config
# Where that directory is mounted inside the container (default /config)
#CONFIG_PATH=/config
# Host folder scans are written to (default ./scans next to compose.yaml)
OUTPUT_PATH=/data/scans
# Own scanned files as this user/group instead of root (e.g. `id -u`/`id -g`)
PUID=1000
PGID=1000
